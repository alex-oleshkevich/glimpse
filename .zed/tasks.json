// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "glimpse-panel",
    "command": "just",
    "args": ["run-panel"],
    "reveal": "never",
    "hide": "on_success",
    "env": {
      "RUST_LOG": "debug",
      "GLIMPSE_THEMES_DIR": "data/themes",
      "GLIMPSE_PANEL_APP_ID": "me.aresa.GlimpsePanel.Dev",
      "GLIMPSE_CONFIG_DIR": "var/config",
      "XDG_CONFIG_HOME": "$ZED_WORKTREE_ROOT/var/xdg-config",
    },
  },
  {
    "label": "glimpse-wallpaper",
    "command": "just",
    "args": ["run-wallpaper"],
    "reveal": "never",
    "hide": "on_success",
    "env": {
      "GLIMPSE_WALLPAPER_APP_ID": "me.aresa.GlimpseWallpaper.Dev",
      "GLIMPSE_CONFIG_DIR": "var/config",
      "XDG_CONFIG_HOME": "$ZED_WORKTREE_ROOT/var/xdg-config",
    },
  },
]
