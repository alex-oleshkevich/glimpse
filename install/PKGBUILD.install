post_install() {
      glib-compile-schemas /usr/share/glib-2.0/schemas
      echo "==> To enable the Super+Space hotkey, run:"
      echo "    gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings \"['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/glimpse/']\""
      echo "    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/glimpse/ name 'Glimpse
  Launcher'"
      echo "    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/glimpse/ command
  'glimpse'"
      echo "    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/glimpse/ binding
  '<Super>space'"
      echo ""
      echo "==> To enable the daemon on login:"
      echo "    systemctl --user enable --now glimpsed.service"
  }

  post_upgrade() {
      post_install
  }

  pre_remove() {
      systemctl --user disable --now glimpsed.service 2>/dev/null || true
  }

  post_remove() {
      glib-compile-schemas /usr/share/glib-2.0/schemas
  }
