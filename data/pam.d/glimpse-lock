#%PAM-1.0

# glimpse-lock calls pam_authenticate() and pam_acct_mgmt() only.
# Keep `auth` and `account` as the full system-auth chain (we rely on
# pam_faillock for account lockout via the account phase). Stub `password`
# and `session` with pam_deny.so so a future accidental call to
# pam_chauthtok() or pam_open_session() fails fast instead of silently
# pulling in pam_keyinit (revokes the user's kernel keyring), pam_systemd
# (double-registers the logind session), pam_loginuid (audit clobber), etc.
auth      include   system-auth
account   include   system-auth
password  required  pam_deny.so
session   required  pam_deny.so
