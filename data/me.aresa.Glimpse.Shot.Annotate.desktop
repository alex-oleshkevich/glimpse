[Desktop Entry]
Type=Application
Name=Annotate Image
Comment=Open an image and mark it up
Icon=me.aresa.Glimpse.Shot.Annotate
Exec=glimpse-shot annotate --pick %f
TryExec=glimpse-shot
Terminal=false
StartupNotify=false
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/avif;image/heif;image/jxl;
Categories=Graphics;Utility;
Keywords=image;annotate;annotation;PNG;draw;markup;
