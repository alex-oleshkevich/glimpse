[Unit]
Description=Glimpse lock screen
Documentation=https://github.com/alex-oleshkevich/glimpse
# Start AFTER graphical-session.target so WAYLAND_DISPLAY and XDG_RUNTIME_DIR
# are present in the systemd user manager's environment when this service
# spawns. Same race as glimpse-idle — see that unit for the explanation.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=exec
ExecStart=/usr/bin/glimpse-lock
Restart=on-failure
RestartSec=2

# Defense-in-depth hardening. Note: glimpse-lock uses PAM for password
# auth, which needs access to /etc/pam.d, PAM modules, and setuid helpers
# such as unix_chkpwd. Do not add NoNewPrivileges, RestrictSUIDSGID, or
# ProtectSystem=strict without testing PAM still authenticates.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=graphical-session.target
