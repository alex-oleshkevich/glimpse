[Unit]
Description=Glimpse shell
Documentation=https://github.com/alex-oleshkevich/glimpse
PartOf=graphical-session.target
After=graphical-session.target glimpse-wallpaper.service
Requisite=graphical-session.target
Wants=glimpse-wallpaper.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=exec
ExecStart=/usr/bin/glimpse-shell
Restart=on-failure
RestartSec=2

# Defense-in-depth hardening. The shell is the most resource-hungry
# of the bunch (GTK4 + libadwaita + many applets + tokio runtime), so
# we stick to kernel/cgroup protections only and avoid any sandboxing
# that would interfere with theme loading, fontconfig, GPU access, or
# D-Bus session bus traffic.
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
