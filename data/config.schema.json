  "$defs": {
    "Appearance": {
      "type": "object",
      "properties": {
        "color-scheme": {
          "$ref": "#/$defs/ColorScheme",
          "default": "auto"
        },
        "theme": {
          "type": "string",
          "default": "adwaita"
