    "Backdrop": {
      "type": "object",
      "properties": {
        "blur-radius": {
          "type": "integer",
          "format": "uint32",
          "default": 24,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
