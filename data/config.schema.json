          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          }
        }
      },
      "additionalProperties": false
    },
    "Clock": {
      "type": "object",
      "properties": {
        "date-format": {
          "type": "string",
          "default": "%A, %B %-d"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "time-format": {
          "type": "string",
          "default": "%H:%M"
        }
      },
      "additionalProperties": false
    },
    "ColorScheme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "auto"
      ]
    },
    "Controls": {
      "type": "object",
      "properties": {
        "buttons": {
          "type": "array",
          "default": [
            "wifi",
            "input",
            "weather",
            "battery",
            "power"
          ],
          "items": {
            "$ref": "#/$defs/Button"
          }
        }
      },
      "additionalProperties": false
    },
    "Fit": {
      "type": "string",
      "enum": [
        "cover",
        "contain",
        "fill"
      ]
    },
    "Geolocation": {
      "description": "`manual` carries its coordinates in the table that selects it, so a provider without them cannot\nbe written down: serde refuses the document and names the key that is missing. The alternative —\ntwo loose `Option` fields — makes a half-filled table a runtime problem for every reader.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "geoclue"
            }
          },
          "required": [
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "format": "double"
            },
            "longitude": {
              "type": "number",
              "format": "double"
            },
            "provider": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "provider",
            "latitude",
            "longitude"
          ]
        }
      ]
    },
    "Idle": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "profiles": {
          "$ref": "#/$defs/Profiles",
          "default": {
            "ac": {
              "listeners": [
                {
                  "on-idle": "/usr/share/glimpse/scripts/monitors off",
                  "on-resume": "/usr/share/glimpse/scripts/monitors on",
                  "timeout": 600
                },
                {
                  "on-idle": "loginctl lock-session",
                  "on-resume": "",
                  "timeout": 900
                },
                {
                  "on-idle": "systemctl suspend",
                  "on-resume": "",
                  "timeout": 3600
                }
              ]
            },
            "battery": {
              "listeners": [
                {
                  "on-idle": "/usr/share/glimpse/scripts/monitors off",
                  "on-resume": "/usr/share/glimpse/scripts/monitors on",
                  "timeout": 300
                },
                {
                  "on-idle": "loginctl lock-session",
                  "on-resume": "",
                  "timeout": 900
                },
                {
                  "on-idle": "systemctl suspend",
                  "on-resume": "",
                  "timeout": 1800
                }
              ]
            }
          }
        },
        "respect-inhibitors": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Keyboard": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "remember": {
