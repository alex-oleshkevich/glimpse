[Unit]
Description=Glimpse compositor provider (Hyprland)
Documentation=https://github.com/alex-oleshkevich/glimpse
PartOf=glimpse-session.target
After=glimpse-session.target
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=exec
ExecCondition=/usr/bin/glimpse-compositor-hyprland --probe
ExecStart=/usr/bin/glimpse-compositor-hyprland
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=4
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
