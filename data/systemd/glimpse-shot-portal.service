[Unit]
Description=Glimpse screenshot portal
Documentation=https://github.com/alex-oleshkevich/glimpse
PartOf=glimpse-session.target
Requisite=glimpse-session.target
After=glimpse-session.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=dbus
BusName=me.aresa.Glimpse.Shot.Portal
ExecStart=/usr/bin/glimpse-shot portal
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
