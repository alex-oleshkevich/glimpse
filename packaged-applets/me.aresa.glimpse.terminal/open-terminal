#!/bin/sh
set -eu

run_terminal_env() {
    value="${1:-}"
    [ -n "$value" ] || return 1

    # $TERMINAL often contains a command plus arguments.
    # shellcheck disable=SC2086
    set -- $value
    [ "$#" -gt 0 ] || return 1
    command -v "$1" >/dev/null 2>&1 || return 1
    exec "$@"
}

run_terminal_name() {
    name="${1:-}"
    [ -n "$name" ] || return 1
    command -v "$name" >/dev/null 2>&1 || return 1
    exec "$name"
}

run_terminal_env "${TERMINAL:-}" || true

# $TERM is usually a capability name like xterm-256color, but honor it if it
# happens to name an executable.
run_terminal_name "${TERM:-}" || true

for terminal in \
    x-terminal-emulator \
    ghostty \
    footclient \
    foot \
    kitty \
    wezterm \
    alacritty \
    ptyxis \
    kgx \
    gnome-terminal \
    konsole \
    xfce4-terminal \
    mate-terminal \
    tilix \
    terminator \
    urxvt \
    xterm
do
    run_terminal_name "$terminal" || true
done

echo "glimpse terminal applet: no supported terminal emulator found" >&2
exit 127
