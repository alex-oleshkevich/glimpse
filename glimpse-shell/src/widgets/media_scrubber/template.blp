using Gtk 4.0;

template $MediaScrubber: Box {
  orientation: vertical;
  hexpand: true;

  styles [
    "mpris-scrubber",
  ]

  Scale scale {
    hexpand: true;
    orientation: horizontal;
    draw-value: false;

    styles [
      "mpris-scrubber__scale",
    ]

    adjustment: Adjustment {
      lower: 0;
      upper: 1;
      step-increment: 0.01;
      page-increment: 0.05;
    };
  }
}
