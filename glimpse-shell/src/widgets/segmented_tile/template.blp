using Gtk 4.0;

template $GlimpseSegmentedTile: Box {
  orientation: vertical;

  styles [
    "segmented-tile",
  ]

  Box header {
    orientation: horizontal;
    overflow: hidden;

    styles [
      "segmented-tile__header",
    ]

    Box main {
      orientation: horizontal;
      spacing: 8;
      hexpand: true;

      styles [
        "activatable",
        "segmented-tile__main",
      ]

      Box left_slot {
        valign: center;
        visible: false;

        styles [
          "tile__left",
        ]
      }

      Box labels {
        orientation: vertical;
        hexpand: true;
        valign: center;

        styles [
          "tile__labels",
        ]

        Label primary_label {
          xalign: 0;
          ellipsize: end;
          hexpand: true;

          styles [
            "tile__label_primary",
          ]
        }

        Label secondary_label {
          xalign: 0;
          ellipsize: end;
          visible: false;

          styles [
            "dim-label",
            "caption",
            "tile__label_secondary",
          ]
        }
      }
    }

    Box expander {
      valign: fill;
      visible: false;

      styles [
        "activatable",
        "segmented-tile__expander",
      ]

      Image chevron {
        icon-name: "pan-end-symbolic";
        valign: center;

        styles [
          "tile__chevron",
        ]
      }
    }
  }

  Revealer revealer {
    transition-type: slide_down;
    reveal-child: false;

    Box child_slot {
      orientation: vertical;

      styles [
        "tile__content",
      ]
    }
  }
}
