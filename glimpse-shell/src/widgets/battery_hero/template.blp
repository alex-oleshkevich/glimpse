using Gtk 4.0;

template $BatteryHero: Box {
  orientation: vertical;
  styles ["battery-hero"]

  Box {
    orientation: horizontal;
    spacing: 8;
    styles ["battery-hero-header"]

    Image icon {
      pixel-size: 32;
    }

    Label percentage {
      xalign: 0;
      hexpand: true;
      label: "—";
      styles ["battery-pct"]
    }
  }

  ProgressBar progress {
    fraction: 0;
    styles ["battery-progress"]
  }

  Label state {
    xalign: 0;
    styles ["battery-state-text"]
  }
}
