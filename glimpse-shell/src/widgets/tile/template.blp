using Gtk 4.0;

template $GlimpseTile: Box {
  orientation: horizontal;
  spacing: 8;

  styles [
    "tile",
  ]

  Box left_slot {
    valign: center;
    halign: center;
    visible: false;

    styles [
      "tile__left",
    ]
  }

  Box labels {
    orientation: vertical;
    hexpand: true;
    valign: center;

    styles [
      "tile__labels",
    ]

    Label primary_label {
      xalign: 0;
      ellipsize: end;
      hexpand: true;

      styles [
        "tile__label_primary",
      ]
    }

    Label secondary_label {
      xalign: 0;
      ellipsize: end;
      visible: false;

      styles [
        "dim-label",
        "caption",
        "tile__label_secondary",
      ]
    }
  }

  Box right_slot {
    halign: end;
    valign: center;
    visible: false;

    styles [
      "tile__right",
    ]
  }
}
