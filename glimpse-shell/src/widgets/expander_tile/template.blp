using Gtk 4.0;

template $GlimpseExpanderTile: Box {
  orientation: vertical;

  styles [
    "expander-tile",
  ]

  Box header {
    orientation: horizontal;
    spacing: 8;

    styles [
      "tile",
      "activatable",
      "expander-tile__header",
    ]

    Box left_slot {
      valign: center;
      visible: false;

      styles [
        "tile__left",
      ]
    }

    Box labels {
      orientation: vertical;
      hexpand: true;
      valign: center;

      styles [
        "tile__labels",
      ]

      Label primary_label {
        xalign: 0;
        ellipsize: end;
        hexpand: true;

        styles [
          "tile__label_primary",
        ]
      }

      Label secondary_label {
        xalign: 0;
        ellipsize: end;
        visible: false;

        styles [
          "dim-label",
          "caption",
          "tile__label_secondary",
        ]
      }
    }

    Image chevron {
      icon-name: "pan-end-symbolic";
      valign: center;

      styles [
        "tile__chevron",
      ]
    }
  }

  Revealer revealer {
    transition-type: slide_down;
    reveal-child: false;

    Box child_slot {
      orientation: vertical;

      styles [
        "tile__content",
      ]
    }
  }
}
