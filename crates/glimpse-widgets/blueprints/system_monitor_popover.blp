using Gtk 4.0;

template $SystemMonitorPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "system-monitor-popover",
  ]

  $PopoverShell shell {
    icon-name: "computer-symbolic";
    title: _("System Monitor");

    $Section usage {
      visible: false;

      Gtk.Box {
        orientation: vertical;

        $MeterRow cpu {
          title: _("CPU");
          visible: false;
        }

        $MeterRow memory {
          title: _("Memory");
          visible: false;
        }

        $MeterRow swap {
          title: _("Swap");
          visible: false;
        }

        Gtk.Box disks {
          orientation: vertical;
        }

        $MeterRow gpu {
          title: _("GPU");
          visible: false;
        }

        $MeterRow gpu_memory {
          visible: false;
        }
      }
    }

    $Section details {
      visible: false;

      Gtk.Box {
        orientation: vertical;

        $Row load {
          title: _("Load average");
          visible: false;
        }

        $Row uptime {
          title: _("Uptime");
          visible: false;
        }

        $Row network {
          title: _("Network");
          visible: false;
        }

        $Row cpu_temp {
          title: _("CPU temperature");
          visible: false;
        }

        $Row gpu_temp {
          title: _("GPU temperature");
          visible: false;
        }
      }
    }


  }
}
