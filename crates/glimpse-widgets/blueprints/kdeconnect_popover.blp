using Gtk 4.0;

template $KdeconnectPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "kdeconnect-popover",
  ]

  $PopoverShell shell {
    icon-name: "phone-symbolic";
    title: _("KDE Connect");

    Gtk.Box {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Section devices {
        visible: false;

        Gtk.Box devices_rows {
          orientation: vertical;
        }
      }

      $Section nearby {
        visible: false;

        $ExpanderRow nearby_toggle {
          title: _("Nearby devices");

          Gtk.Box nearby_rows {
            orientation: vertical;
          }

          $ActionRow nearby_more {
            visible: false;
            icon-name: "view-more-symbolic";
          }
        }
      }
    }

    $ActionRow footer {
      visible: false;
    }
  }
}
