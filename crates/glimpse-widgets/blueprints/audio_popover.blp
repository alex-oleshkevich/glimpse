using Gtk 4.0;

template $AudioPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "audio-popover",
  ]

  $PopoverShell shell {
    icon-name: "audio-volume-high-symbolic";
    title: _("Sound");

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Section outputs {
        visible: false;
        title: _("Output");

        Gtk.Box {
          orientation: vertical;

          $SliderRow output {
            [start]
            Gtk.Button output_mute {
              valign: center;

              styles [
                "flat",
              ]
            }
          }

          $ExpanderRow output_device {
            Gtk.Box output_rows {
              orientation: vertical;
            }
          }
        }
      }

      $Section inputs {
        visible: false;
        title: _("Input");

        Gtk.Box {
          orientation: vertical;

          $SliderRow input {
            [start]
            Gtk.Button input_mute {
              valign: center;

              styles [
                "flat",
              ]
            }
          }

          $ExpanderRow input_device {
            Gtk.Box input_rows {
              orientation: vertical;
            }
          }
        }
      }

      $Section apps {
        visible: false;
        title: _("Applications");

        Gtk.Box {
          orientation: vertical;

          Gtk.Box app_rows {
            orientation: vertical;
          }

          $ActionRow more_apps {
            visible: false;
            icon-name: "view-more-symbolic";
          }
        }
      }
    }


  }
}
