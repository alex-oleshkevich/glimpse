using Gtk 4.0;

template $DisplayPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "display-popover",
  ]

  $PopoverShell shell {
    icon-name: "display-brightness-symbolic";
    title: _("Display");

    [addon]
    $Readout readout {
      valign: center;
      visible: false;
      unit: "%";
    }

    Gtk.Box {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Section brightness {
        visible: false;
        title: _("Brightness");

        Gtk.Box {
          orientation: vertical;

          $Row primary_name {
            visible: false;
          }

          $SliderRow primary {
            visible: false;
          }

          $SourceList devices {
            visible: false;
          }

          $ExpanderRow night_light {
            visible: false;
            title: _("Night light");

            Gtk.Box night_facts {
              orientation: vertical;
            }

            $ToggleRow enabled {
              title: _("Enabled");
            }

            $SliderRow temperature {
              styles [
                "slider-row--warm",
              ]
            }

            $ChoiceList schedules {
              visible: false;
            }
          }
        }
      }

      $Section displays_section {
        visible: false;
        title: _("Displays");

        Gtk.Box {
          orientation: vertical;

          $DisplayList displays {}

          $ActionRow blank {
            visible: false;
            title: _("Blank the screens");
          }
        }
      }
    }


  }
}
