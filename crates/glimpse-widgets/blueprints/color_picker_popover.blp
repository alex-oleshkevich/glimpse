using Gtk 4.0;

template $ColorPickerPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "color-picker-popover",
  ]

  $PopoverShell shell {
    icon-name: "color-select-symbolic";
    title: _("Color picker");

    [addon]
    $Swatch latest {
      visible: false;
      valign: center;

      styles [
        "swatch--hero",
      ]
    }

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $ActionRow pick {
        title: _("Pick a color");
        icon-name: "color-select-symbolic";
      }

      $Section palette_section {
        visible: false;
        title: _("Palette");

        $ColorList palette {}
      }
    }
  }
}
