using Gtk 4.0;

template $LockStage: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "lock-stage",
  ]

  Gtk.Overlay overlay {
    child: Gtk.Picture base {
      can-shrink: true;
      can-target: false;
      content-fit: fill;
      accessible-role: presentation;
    };

    [overlay]
    Gtk.Picture background {
      can-shrink: true;
      can-target: false;
      content-fit: cover;
      accessible-role: presentation;
    }

    [overlay]
    Gtk.Picture blurred {
      can-shrink: true;
      can-target: false;
      content-fit: cover;
      accessible-role: presentation;

      styles [
        "lock-stage__blurred",
      ]
    }

    [overlay]
    Gtk.Box scrim {
      opacity: 0;
      can-target: false;
      accessible-role: presentation;

      styles [
        "lock-stage__scrim",
      ]
    }

    [overlay]
    Gtk.CenterBox layout {
      orientation: vertical;

      [start]
      Gtk.Overlay corner {
        halign: end;
        accessible-role: presentation;

        child: $StatusIsland status {
          can-target: false;

          styles [
            "lock-stage__edge",
            "lock-stage__top",
          ]
        };

        [overlay]
        Gtk.Box cover {
          halign: end;
          valign: start;
          spacing: 12;
          can-target: false;

          styles [
            "lock-stage__edge",
            "lock-stage__cover",
          ]

          $Indicator cover_notifications {
            visible: false;
          }

          $Indicator cover_battery {
            visible: false;
          }

          Gtk.Image cover_power {
            icon-name: "system-shutdown-symbolic";
            visible: false;
            accessible-role: presentation;

            styles [
              "indicator__icon",
              "lock-stage__ghost",
            ]
          }
        }
      }

      [center]
      Gtk.Box {
        orientation: vertical;
        halign: center;
        valign: center;

        $LockClock clock {}

        Gtk.Revealer reveal {
          transition-type: slide_down;
          transition-duration: 380;

          Gtk.Box unlock {
            orientation: vertical;
            halign: center;

            styles [
              "lock-stage__unlock",
            ]

            Gtk.Overlay avatar {
              halign: center;
              width-request: 88;
              height-request: 88;
              overflow: hidden;
              accessible-role: presentation;

              styles [
                "lock-stage__avatar",
              ]

              Gtk.Label initials {
                halign: center;
                valign: center;
                accessible-role: presentation;

                styles [
                  "lock-stage__initials",
                ]
              }

              [overlay]
              Gtk.Picture photo {
                visible: false;
                can-shrink: true;
                content-fit: cover;
                accessible-role: presentation;
              }
            }

            $PasswordPrompt prompt {
              halign: center;

              styles [
                "lock-stage__prompt",
              ]
            }
          }
        }
      }

      [end]
      Gtk.Box {
        spacing: 12;

        Gtk.Box bottom {
          spacing: 12;
          hexpand: true;
          can-target: false;

          styles [
            "lock-stage__edge",
            "lock-stage__bottom",
          ]

          $TrackCard track {
            hexpand: true;
            halign: end;
            valign: end;
          }
        }
      }
    }

    [overlay]
    $SessionSheet sheet {
      halign: end;
      valign: start;

      styles [
        "lock-stage__sheet",
      ]
    }
  }
}
