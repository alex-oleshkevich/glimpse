using Gtk 4.0;

template $BrightnessPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "brightness-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "display-brightness-symbolic";
      title: _("Brightness");

      [slot]
      $Readout readout {
        valign: center;
        visible: false;
      }
    }

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Row primary_name {
        visible: false;
        activatable: false;
      }

      $Fader primary {
        visible: false;
        toggleable: false;
        icon-name: "display-brightness-symbolic";
      }

      $SourceList devices {
        visible: false;
      }

      $Expandable night_light {
        visible: false;

        $Row night_head {
          title: _("Night light");

          [trail]
          Gtk.Image {
            icon-name: "go-next-symbolic";
            accessible-role: presentation;

            styles [
              "drawer-chevron",
            ]
          }
        }

        [details]
        Gtk.Box {
          orientation: vertical;

          $SwitchRow enabled {
            title: _("Enabled");
          }

          $Fader temperature {
            toggleable: false;
            icon-name: "night-light-symbolic";

            styles [
              "fader--warm",
            ]
          }

          $ChoiceList schedules {}
        }
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
