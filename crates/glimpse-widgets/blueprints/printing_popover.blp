using Gtk 4.0;

template $PrintingPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "printing-popover",
  ]

  $PopoverShell shell {
    title: _("Printing");

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Section jobs {
        visible: false;
        title: _("Print jobs");

        Gtk.Box job_rows {
          orientation: vertical;
        }
      }

      $Section printers {
        visible: false;
        title: _("Printers");

        Gtk.Box printer_rows {
          orientation: vertical;
        }
      }
    }

    [footer]
    $ActionRow footer {
      visible: false;
    }
  }
}
