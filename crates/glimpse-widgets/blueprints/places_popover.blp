using Gtk 4.0;

template $PlacesPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "places-popover",
  ]

  $PopoverShell shell {
    icon-name: "folder-symbolic";
    title: _("Places");

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Section places {
        visible: false;
        title: _("Places");

        Gtk.Box places_rows {
          orientation: vertical;
        }
      }

      $Section bookmarks {
        visible: false;
        title: _("Bookmarks");

        Gtk.Box {
          orientation: vertical;

          Gtk.Box bookmarks_rows {
            orientation: vertical;
          }

          $ActionRow bookmarks_more {
            visible: false;
            icon-name: "view-more-symbolic";
          }
        }
      }

      $Section network {
        visible: false;
        title: _("Network");

        Gtk.Box network_rows {
          orientation: vertical;
        }
      }

      $Section trash {
        visible: false;
        title: _("Trash");

        $ExpanderRow trash_item {
          title: _("Trash");

          $ActionRow trash_open {
            title: _("Open the trash");
          }

          $ActionRow trash_empty {
            title: _("Empty the trash");
            tone: destructive;
          }
        }
      }
    }


  }
}
