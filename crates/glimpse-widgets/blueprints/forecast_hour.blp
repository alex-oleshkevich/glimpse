using Gtk 4.0;

template $ForecastHour: Gtk.Widget {
  layout-manager: BoxLayout {
    orientation: vertical;
    spacing: 5;
  };

  halign: center;

  styles [
    "forecast-hour",
  ]

  Gtk.Label time {
    single-line-mode: true;
    visible: false;
    accessible-role: presentation;

    styles [
      "caption",
    ]
  }

  Gtk.Image icon {
    pixel-size: 28;
    visible: false;
    accessible-role: presentation;
  }

  Gtk.Label temperature {
    single-line-mode: true;
    visible: false;
    accessible-role: presentation;

    styles [
      "numeric",
    ]
  }
}
