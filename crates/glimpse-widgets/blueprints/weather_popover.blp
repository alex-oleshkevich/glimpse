using Gtk 4.0;

template $WeatherPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "weather-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "weather-clear-symbolic";

      [slot]
      $Readout reading {
        valign: center;
        visible: false;
      }
    }

    Gtk.Box {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Section hourly {
        $ForecastStrip hours {}
      }

      Gtk.Separator hourly_rule {
        orientation: horizontal;
      }

      $Section daily {
        $ForecastList days {}
      }

      Gtk.Separator daily_rule {
        orientation: horizontal;
      }

      $Notice nowcast {
        visible: false;
      }

      Gtk.Box alerts {
        orientation: vertical;
        visible: false;

        styles [
          "weather-popover__alerts",
        ]
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
