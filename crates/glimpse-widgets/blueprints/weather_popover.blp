using Gtk 4.0;

template $WeatherPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "weather-popover",
  ]

  $PopoverShell shell {
    icon-name: "weather-clear-symbolic";

    [addon]
    $Readout reading {
      valign: center;
      visible: false;
    }

    Gtk.Box {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Section hourly {
        $ForecastStrip hours {}
      }

      Gtk.Separator hourly_rule {
        orientation: horizontal;
      }

      $Section daily {
        $ForecastList days {}
      }

      Gtk.Separator daily_rule {
        orientation: horizontal;
      }

      Gtk.Box {
        orientation: vertical;
        spacing: 6;

        $Notice nowcast {
          visible: false;
        }

        Gtk.Box alerts {
          orientation: vertical;
          spacing: 6;
          visible: false;
        }
      }
    }
  }
}
