using Gtk 4.0;

template $WorkspaceNamePopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "workspace-name-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "view-grid-symbolic";
    }

    Gtk.Box {
      orientation: vertical;

      styles [
        "column",
      ]

      Gtk.Box {
        orientation: vertical;

        styles [
          "prompt",
        ]

        Gtk.Entry name {
          placeholder-text: _("Name this workspace");
          max-length: 128;
          secondary-icon-name: "edit-clear-symbolic";
          secondary-icon-tooltip-text: _("Clear");
          input-purpose: free_form;
        }

        Gtk.Label taken {
          visible: false;
          xalign: 0;
          wrap: true;
          max-width-chars: 32;

          styles [
            "prompt__ask",
            "workspace-name-popover__taken",
          ]
        }
      }

      $Section recent {
        visible: false;
        title: _("Recent names");

        Gtk.Box recent_rows {
          orientation: vertical;
        }
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
