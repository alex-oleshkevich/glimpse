using Gtk 4.0;

template $BluetoothPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "bluetooth-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "bluetooth-symbolic";

      [slot]
      Gtk.Switch power {
        valign: center;
        tooltip-text: _("Bluetooth");
      }
    }

    Gtk.Stack pages {
      transition-type: crossfade;
      vhomogeneous: false;

      Gtk.StackPage {
        name: "devices";

        child: Gtk.Box column {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
          ]

          $Section devices {
            visible: false;
            title: _("Devices");

            Gtk.Box {
              orientation: vertical;

              Gtk.Box device_rows {
                orientation: vertical;
              }

              $Row more_paired {
                visible: false;
                activatable: true;
                lead-icon: "view-more-symbolic";
              }
            }
          }

          $Section nearby {
            visible: false;

            Gtk.Box {
              orientation: vertical;

              $Row search {
                activatable: true;
                title: _("Nearby devices");

                [trail]
                Gtk.Image {
                  icon-name: "go-next-symbolic";
                  accessible-role: presentation;

                  styles [
                    "drawer-chevron",
                  ]
                }
              }

              Gtk.Box nearby_list {
                orientation: vertical;
                visible: false;

                Gtk.Box nearby_rows {
                  orientation: vertical;
                }

                $Row more_nearby {
                  visible: false;
                  activatable: true;
                  lead-icon: "view-more-symbolic";
                }
              }
            }
          }
        };
      }

      Gtk.StackPage {
        name: "prompt";

        child: Gtk.Box prompt_page {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
            "prompt",
          ]

          Gtk.Label prompt_device {
            wrap: true;
            justify: center;
            max-width-chars: 24;

            styles [
              "prompt__device",
            ]
          }

          Gtk.Label prompt_ask {
            wrap: true;
            justify: center;
            max-width-chars: 30;

            styles [
              "prompt__ask",
            ]
          }

          Gtk.Label prompt_code {
            visible: false;
            ellipsize: end;
            max-width-chars: 16;

            styles [
              "prompt__code",
            ]
          }

          Gtk.Label prompt_progress {
            visible: false;

            styles [
              "prompt__progress",
            ]
          }

          Gtk.Box prompt_actions {
            orientation: horizontal;
            homogeneous: true;
            spacing: 8;

            styles [
              "prompt__actions",
            ]

            Gtk.Button prompt_cancel {
              label: _("Cancel");
            }

            Gtk.Button prompt_accept {
              visible: false;
              label: _("Confirm");
            }
          }
        };
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
