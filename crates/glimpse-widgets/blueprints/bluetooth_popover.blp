using Gtk 4.0;

template $BluetoothPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "bluetooth-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "bluetooth-symbolic";

      [slot]
      Gtk.Switch power {
        valign: center;
        tooltip-text: _("Bluetooth");
      }
    }

    Gtk.Stack pages {
      transition-type: crossfade;
      vhomogeneous: false;

      Gtk.StackPage {
        name: "devices";

        child: Gtk.Box column {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
          ]

          $Section connected {
            visible: false;

            Gtk.Box connected_rows {
              orientation: vertical;
            }
          }

          $Section paired {
            visible: false;
            title: _("Paired");

            Gtk.Box {
              orientation: vertical;

              Gtk.Box paired_rows {
                orientation: vertical;
              }

              $Row more_paired {
                visible: false;
                activatable: true;
                lead-icon: "view-more-symbolic";
              }
            }
          }

          $Section nearby {
            visible: false;
            empty: true;
            title: _("Nearby");

            [placeholder]
            $Placeholder looking {
              icon-name: "bluetooth-symbolic";
              title: _("Looking for devices");
              description: _("Put the device in pairing mode to make it show up here.");
            }

            Gtk.Box {
              orientation: vertical;

              Gtk.Box nearby_rows {
                orientation: vertical;
              }

              $Row more_nearby {
                visible: false;
                activatable: true;
                lead-icon: "view-more-symbolic";
              }
            }
          }

          $SwitchRow search {
            title: _("Search for devices");
          }

          $SwitchRow discoverable {
            title: _("Visible to other devices");
          }
        };
      }

      Gtk.StackPage {
        name: "prompt";

        child: Gtk.Box prompt_page {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
            "prompt",
          ]

          Gtk.Label prompt_device {
            wrap: true;
            justify: center;
            max-width-chars: 24;

            styles [
              "prompt__device",
            ]
          }

          Gtk.Label prompt_ask {
            wrap: true;
            justify: center;
            max-width-chars: 30;

            styles [
              "prompt__ask",
            ]
          }

          Gtk.Label prompt_code {
            visible: false;
            ellipsize: end;
            max-width-chars: 16;

            styles [
              "prompt__code",
            ]
          }

          Gtk.Label prompt_progress {
            visible: false;

            styles [
              "prompt__progress",
            ]
          }

          Gtk.Box prompt_actions {
            orientation: horizontal;
            homogeneous: true;
            spacing: 8;

            styles [
              "prompt__actions",
            ]

            Gtk.Button prompt_cancel {
              label: _("Cancel");
            }

            Gtk.Button prompt_accept {
              visible: false;
              label: _("Confirm");
            }
          }
        };
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
