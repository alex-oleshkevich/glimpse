using Gtk 4.0;

template $BluetoothPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "bluetooth-popover",
  ]

  $PopoverShell shell {
    icon-name: "bluetooth-symbolic";

    [addon]
    Gtk.Switch power {
      valign: center;
      tooltip-text: _("Bluetooth");
    }

    Gtk.Stack pages {
      transition-type: crossfade;
      vhomogeneous: false;

      Gtk.StackPage {
        name: "devices";

        child: Gtk.Box column {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
          ]

          $Section devices {
            visible: false;

            Gtk.Box {
              orientation: vertical;

              Gtk.Box device_rows {
                orientation: vertical;
              }

              $ActionRow more_paired {
                visible: false;
                icon-name: "view-more-symbolic";
              }
            }
          }

          $Section nearby {
            visible: false;

            $ExpanderRow search {
              title: _("Nearby devices");

              Gtk.Box nearby_rows {
                orientation: vertical;
              }

              $ActionRow more_nearby {
                visible: false;
                icon-name: "view-more-symbolic";
              }
            }
          }
        };
      }

      Gtk.StackPage {
        name: "prompt";

        child: Gtk.Box prompt_page {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
            "prompt",
          ]

          Gtk.Label prompt_device {
            wrap: true;
            justify: center;
            max-width-chars: 24;

            styles [
              "prompt__device",
            ]
          }

          Gtk.Label prompt_ask {
            wrap: true;
            justify: center;
            max-width-chars: 30;

            styles [
              "prompt__ask",
            ]
          }

          Gtk.Box {
            orientation: horizontal;
            homogeneous: true;
            spacing: 8;

            styles [
              "prompt__actions",
            ]

            Gtk.Button prompt_cancel {
              label: _("Cancel");
            }

            Gtk.Button prompt_accept {
              visible: false;
              label: _("Confirm");
            }
          }
        };
      }
    }
  }
}
