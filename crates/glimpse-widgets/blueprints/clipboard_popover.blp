using Gtk 4.0;

template $ClipboardPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "clipboard-popover",
  ]

  $PopoverShell shell {
    icon-name: "edit-paste-symbolic";
    title: _("Clipboard");

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Notice trouble {
        visible: false;
        icon-name: "dialog-warning-symbolic";
      }

      Gtk.SearchEntry search {
        visible: false;
        placeholder-text: _("Search clipboard");

        styles [
          "clipboard-popover__search",
        ]
      }

      $Section pinned_section {
        title: _("Pinned");
        visible: false;

        $ClipboardList pinned {}
      }

      $Section recent_section {
        title: _("Recent");
        visible: false;

        Gtk.Box {
          orientation: vertical;

          $ClipboardList recent {}

          $ActionRow more {
            visible: false;
            icon-name: "view-more-symbolic";
          }
        }
      }
    }

    $ActionRow clear {
      visible: false;
      icon-name: "edit-clear-all-symbolic";
    }

    $ActionRow footer {
      visible: false;
    }
  }
}
