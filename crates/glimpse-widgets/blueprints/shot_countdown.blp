using Gtk 4.0;

template $ShotCountdown: Gtk.Widget {
  layout-manager: BinLayout {};

  Gtk.Box {
    spacing: 12;
    halign: center;

    styles [
      "pill-surface",
      "pill-surface--pill",
      "pill-surface--compact",
    ]

    Gtk.Label label {
      valign: center;

      styles [
        "shot-countdown",
      ]
    }

    Gtk.Button cancel {
      icon-name: "window-close-symbolic";
      tooltip-text: _("Cancel the screenshot");
      valign: center;

      styles [
        "flat",
        "circular",
      ]
    }
  }
}
