using Gtk 4.0;

template $NextEventPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "next-event-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "appointment-soon-symbolic";

      [slot]
      $Readout countdown {
        visible: false;
      }
    }

    Gtk.Box {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $ActionRow join {
        visible: false;
        icon-name: "camera-web-symbolic";
      }

      $ActionRow open_event {
        visible: false;
        icon-name: "x-office-calendar-symbolic";
      }

      $Section details {
        visible: false;
        title: _("Details");

        Gtk.Box facts {
          orientation: vertical;
        }
      }

      $Section upcoming {
        visible: false;
        title: _("Coming up");

        $EventList later {}
      }
    }

    [footer]
    $ActionRow footer {
      visible: false;
    }
  }
}
