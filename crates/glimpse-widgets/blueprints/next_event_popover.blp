using Gtk 4.0;

template $NextEventPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "next-event-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "appointment-soon-symbolic";

      [slot]
      $Readout countdown {
        visible: false;
      }
    }

    Gtk.Box {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Row join {
        visible: false;
        lead-icon: "camera-web-symbolic";
        activatable: true;
      }

      $Row open_event {
        visible: false;
        lead-icon: "x-office-calendar-symbolic";
        activatable: true;
      }

      $Section details {
        visible: false;
        title: _("Details");

        $FactList facts {}
      }

      $Section upcoming {
        visible: false;
        title: _("Coming up");

        $EventList later {}
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
