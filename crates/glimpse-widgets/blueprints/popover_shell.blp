using Gtk 4.0;

template $PopoverShell: Gtk.Widget {
  styles [
    "popover-shell",
  ]

  $AppletPopover card {
    Gtk.Box {
      orientation: vertical;

      $Hero header {
        visible: false;

        styles [
          "popover-shell__header",
        ]
      }

      Gtk.ScrolledWindow scroller {
        visible: bind body.visible;
        hscrollbar-policy: never;
        propagate-natural-height: true;
        vexpand: true;

        Gtk.Box body {
          orientation: vertical;

          styles [
            "popover-shell__content",
            "popover-body",
          ]
        }
      }
    }
  }
}
