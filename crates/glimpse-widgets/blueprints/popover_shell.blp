using Gtk 4.0;

template $PopoverShell: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "popover-shell",
  ]

  $AppletPopover card {
    Gtk.Box {
      orientation: vertical;

      $Hero header {
        visible: false;

        styles [
          "popover-shell__header",
        ]
      }

      Gtk.Box hero_box {
        orientation: vertical;
        visible: false;

        styles [
          "popover-shell__hero",
        ]
      }

      Gtk.Separator hero_rule {
        orientation: horizontal;
        visible: false;
      }

      Gtk.ScrolledWindow scroller {
        visible: bind body.visible;
        hscrollbar-policy: never;
        propagate-natural-height: true;
        vexpand: true;

        Gtk.Box body {
          orientation: vertical;

          styles [
            "popover-shell__content",
            "popover-body",
          ]
        }
      }

      Gtk.Separator footer_rule {
        orientation: horizontal;
        visible: false;
      }

      Gtk.Box footer_box {
        orientation: horizontal;
        spacing: 6;
        visible: false;

        styles [
          "popover-shell__footer",
        ]
      }
    }
  }
}
