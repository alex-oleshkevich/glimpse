using Gtk 4.0;
using Adw 1;

template $RemovablePopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "removable-popover",
  ]

  $PopoverShell shell {
    icon-name: "drive-removable-media-symbolic";
    title: _("Removable");

    Adw.Bin {
      styles [
        "column",
      ]

      $Section devices {
        visible: false;

        Gtk.Box {
          orientation: vertical;

          Gtk.Box devices_rows {
            orientation: vertical;
          }

          $ExpanderRow devices_more {
            visible: false;

            Gtk.Box more_rows {
              orientation: vertical;
            }
          }
        }
      }
    }
  }
}
