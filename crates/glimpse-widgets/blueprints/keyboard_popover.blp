using Gtk 4.0;

template $KeyboardPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "keyboard-popover",
  ]

  $PopoverShell shell {
    icon-name: "input-keyboard-symbolic";
    title: _("Keyboard");

    $Section layouts {
      Gtk.Box rows {
        orientation: vertical;
      }
    }


  }
}
