using Gtk 4.0;

template $KeyboardPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "keyboard-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "input-keyboard-symbolic";
      title: _("Keyboard");
    }

    $Section layouts {
      styles [
        "column",
      ]

      Gtk.Box rows {
        orientation: vertical;
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
