using Gtk 4.0;

template $NetworkPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "network-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "network-wireless-symbolic";

      [slot]
      Gtk.Switch wifi {
        valign: center;
        tooltip-text: _("Wi-Fi");
      }
    }

    Gtk.Stack pages {
      transition-type: crossfade;
      vhomogeneous: false;

      Gtk.StackPage {
        name: "networks";

        child: Gtk.Box column {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
          ]

          $Section wired {
            visible: false;
            title: _("Ethernet");

            Gtk.Box wired_rows {
              orientation: vertical;
            }
          }

          $Section vpn {
            visible: false;
            title: _("VPN");

            Gtk.Box vpn_rows {
              orientation: vertical;
            }
          }

          $Section wifi_section {
            visible: false;
            title: _("Wi-Fi");

            Gtk.Box wifi_rows {
              orientation: vertical;
            }
          }

          $Section other {
            visible: false;

            Gtk.Box {
              orientation: vertical;

              $Row more {
                visible: false;
                activatable: true;
                title: _("Other networks");

                [trail]
                Gtk.Image {
                  icon-name: "go-next-symbolic";
                  accessible-role: presentation;

                  styles [
                    "drawer-chevron",
                  ]
                }

                styles [
                  "network-popover__others",
                ]
              }

              Gtk.Box other_rows {
                orientation: vertical;
              }

              $Row all {
                visible: false;
                activatable: true;
                lead-icon: "view-more-symbolic";
              }
            }

            [placeholder]
            $Placeholder looking {
              icon-name: "network-wireless-acquiring-symbolic";
              title: _("Looking for networks…");
            }
          }

          Gtk.Separator hidden_rule {
            visible: false;

            styles [
              "network-popover__rule",
            ]
          }

          $Row hidden {
            visible: false;
            activatable: true;
            title: _("Connect to a hidden network…");
            lead-icon: "list-add-symbolic";
          }
        };
      }

      Gtk.StackPage {
        name: "prompt";

        child: Gtk.Box prompt_page {
          orientation: vertical;
          hexpand: true;

          styles [
            "column",
            "prompt",
          ]

          Gtk.Label prompt_network {
            wrap: true;
            justify: center;
            max-width-chars: 24;

            styles [
              "prompt__device",
            ]
          }

          Gtk.Label prompt_ask {
            wrap: true;
            justify: center;
            max-width-chars: 30;

            styles [
              "prompt__ask",
            ]
          }

          Gtk.DropDown prompt_security {
            visible: false;

            styles [
              "prompt__security",
            ]
          }

          Gtk.PasswordEntry prompt_secret {
            show-peek-icon: true;
            activates-default: true;
          }

          Gtk.Entry prompt_name {
            visible: false;
            input-purpose: free_form;
          }

          Gtk.Box prompt_actions {
            orientation: horizontal;
            homogeneous: true;
            spacing: 8;

            styles [
              "prompt__actions",
              "prompt__actions--bare",
            ]

            Gtk.Button prompt_cancel {
              label: _("Cancel");
            }

            Gtk.Button prompt_accept {
              label: _("Connect");

              styles [
                "prompt__accept",
              ]
            }
          }
        };
      }
    }

    [footer]
    $Row footer {
      visible: false;
    }
  }
}
