using Gtk 4.0;

template $PlayerRow: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "player-row",
  ]

  $ActionRow row {
    [end]
    Gtk.Button toggle {
      icon-name: "media-playback-start-symbolic";
      has-frame: false;
      valign: center;
      tooltip-text: _("Play");

      styles [
        "player-row__toggle",
      ]
    }
  }
}
