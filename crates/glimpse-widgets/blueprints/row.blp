using Gtk 4.0;

template $Row: Gtk.Widget {
  focusable: false;
  can-target: true;
  accessible-role: list_item;
  layout-manager: BoxLayout {
    orientation: vertical;
  };

  Gtk.Box content {
    vexpand: true;
    accessible-role: presentation;

    styles [
      "row__content",
    ]

    Gtk.Image icon {
      visible: false;
      accessible-role: presentation;

      styles [
        "row__icon",
      ]
    }

    Gtk.Box start {
      visible: false;
      valign: center;
      halign: center;
      accessible-role: presentation;
    }

    Gtk.Box text {
      orientation: vertical;
      valign: center;
      hexpand: true;
      accessible-role: presentation;

      Gtk.Label title {
        visible: false;
        xalign: 0;
        ellipsize: end;
        single-line-mode: true;
        lines: 1;
        max-width-chars: 24;
        accessible-role: presentation;

        styles [
          "row__title",
        ]
      }

      Gtk.Label subtitle {
        visible: false;
        xalign: 0;
        ellipsize: end;
        single-line-mode: true;
        max-width-chars: 24;
        accessible-role: presentation;

        styles [
          "row__subtitle",
        ]
      }
    }

    Gtk.Label value {
      visible: false;
      hexpand: true;
      xalign: 1;
      ellipsize: end;
      single-line-mode: true;
      max-width-chars: 16;
      accessible-role: presentation;

      styles [
        "row__value",
      ]
    }

    Gtk.Spinner spinner {
      visible: false;
      accessible-role: presentation;

      styles [
        "row__spinner",
      ]
    }

    Gtk.Box end {
      visible: false;
      valign: center;
      accessible-role: presentation;
    }

    Gtk.Image check {
      visible: false;
      icon-name: "object-select-symbolic";
      accessible-role: presentation;

      styles [
        "row__check",
      ]
    }

    Gtk.Image chevron {
      visible: false;
      icon-name: "pan-end-symbolic";
      accessible-role: presentation;
      styles ["row__chevron"]
    }
  }
}
