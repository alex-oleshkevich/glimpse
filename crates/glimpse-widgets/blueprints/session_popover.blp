using Gtk 4.0;

template $SessionPopover: Gtk.Widget {
  $PopoverShell shell {
    icon-name: "avatar-default-symbolic";

    $Section {
      Gtk.Box {
        orientation: vertical;

        $ActionRow lock {
          title: _("Lock");
          icon-name: "system-lock-screen-symbolic";
        }

        $ActionRow suspend {
          title: _("Suspend");
          icon-name: "weather-clear-night-symbolic";
        }

        $ActionRow hibernate {
          title: _("Hibernate");
          icon-name: "document-save-symbolic";
        }
      }
    }

    $Section {
      Gtk.Box {
        orientation: vertical;

        $ActionRow logout {
          title: _("Log out");
          icon-name: "system-log-out-symbolic";
        }

        $ActionRow reboot {
          title: _("Restart");
          icon-name: "system-reboot-symbolic";
        }

        $ActionRow power_off {
          title: _("Shut down");
          icon-name: "system-shutdown-symbolic";
        }
      }
    }


  }
}
