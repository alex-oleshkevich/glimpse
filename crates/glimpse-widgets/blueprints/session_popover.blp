using Gtk 4.0;

template $SessionPopover: Gtk.Widget {
  $PopoverShell shell {
    [hero]
    $Hero hero {}

    Gtk.Box {
      orientation: vertical;
      spacing: 8;

      $Section {
        Gtk.Box {
          orientation: vertical;

          $LegacyRow lock {
            title: _("Lock");
            lead-icon: "system-lock-screen-symbolic";
          }

          $LegacyRow suspend {
            title: _("Suspend");
            lead-icon: "weather-clear-night-symbolic";
          }

          $LegacyRow hibernate {
            title: _("Hibernate");
            lead-icon: "document-save-symbolic";
          }
        }
      }

      $Section {
        Gtk.Box {
          orientation: vertical;

          $LegacyRow logout {
            title: _("Log out");
            lead-icon: "system-log-out-symbolic";
          }

          $LegacyRow reboot {
            title: _("Restart");
            lead-icon: "system-reboot-symbolic";
          }

          $LegacyRow power_off {
            title: _("Shut down");
            lead-icon: "system-shutdown-symbolic";
          }
        }
      }
    }

    [footer]
    $LegacyRow footer {
      visible: false;
    }
  }
}
