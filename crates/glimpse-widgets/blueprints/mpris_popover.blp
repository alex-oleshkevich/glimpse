using Gtk 4.0;

template $MprisPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "mpris-popover",
  ]

  $AppletPopover card {
    Gtk.ScrolledWindow scroller {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;
      propagate-natural-height: true;

      Gtk.Box {
        orientation: vertical;

        styles [
          "column",
          "popover-body",
        ]

        $NowPlaying player {
          visible: false;
          icon-name: "multimedia-player-symbolic";
        }

        $Fader volume {
          visible: false;
          toggleable: false;
          icon-name: "audio-volume-high-symbolic";
        }

        $Section others {
          visible: false;
          title: _("Other players");

          $PlayerList list {}
        }

        $LegacyRow footer {
          visible: false;
        }
      }
    }
  }
}
