using Gtk 4.0;

template $NotificationsPopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "notifications-popover",
  ]

  $PopoverShell shell {
    icon-name: "preferences-system-notifications-symbolic";
    title: _("Notifications");
    size: wide;

    Gtk.Box column {
      orientation: vertical;

      styles [
        "column",
      ]

      $Notice trouble {
        visible: false;
        severity: error;
        icon-name: "dialog-error-symbolic";
        title: _("Notifications are unavailable");
      }

      Gtk.Box groups {
        orientation: vertical;
        visible: false;
      }

      Gtk.Revealer empty_reveal {
        transition-type: slide_down;
        reveal-child: true;

        $Placeholder empty {
          icon-name: "preferences-system-notifications-symbolic";
          title: _("Nothing new");
          description: _("You are all caught up.");
        }
      }
    }

    $ActionRow clear {
      visible: false;
    }
  }
}
