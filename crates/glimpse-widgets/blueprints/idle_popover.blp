using Gtk 4.0;

template $IdlePopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "idle-popover",
  ]

  $PopoverShell shell {
    [hero]
    $Hero hero {
      icon-name: "view-conceal-symbolic";

      [slot]
      Gtk.Switch hold {
        valign: center;
        tooltip-text: _("Keep awake");
      }
    }

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $Expandable hold_card {
        $LegacyRow hold_row {
          title: _("Keep awake for…");

          [trail]
          Gtk.Image {
            icon-name: "go-next-symbolic";
            accessible-role: presentation;

            styles [
              "drawer-chevron",
            ]
          }
        }

        [details]
        Gtk.Box {
          orientation: vertical;

          $LegacyRow preset_15m {
            activatable: true;
            title: _("15 minutes");
          }

          $LegacyRow preset_30m {
            activatable: true;
            title: _("30 minutes");
          }

          $LegacyRow preset_1h {
            activatable: true;
            title: _("1 hour");
          }

          $LegacyRow preset_2h {
            activatable: true;
            title: _("2 hours");
          }

          $LegacyRow preset_4h {
            activatable: true;
            title: _("4 hours");
          }
        }
      }

      $Section others {
        visible: false;
        title: _("Kept awake by");

        $InhibitorList list {}
      }
    }

    [footer]
    $LegacyRow footer {
      visible: false;
    }
  }
}
