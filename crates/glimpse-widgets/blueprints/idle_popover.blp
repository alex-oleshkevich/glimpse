using Gtk 4.0;

template $IdlePopover: Gtk.Widget {
  layout-manager: BinLayout {};

  styles [
    "idle-popover",
  ]

  $PopoverShell shell {
    icon-name: "view-conceal-symbolic";

    [addon]
    Gtk.Switch hold {
      valign: center;
      tooltip-text: _("Keep awake");
    }

    Gtk.Box column {
      orientation: vertical;
      hexpand: true;

      styles [
        "column",
      ]

      $ExpanderRow hold_card {
        title: _("Keep awake for…");

        $ToggleRow preset_15m {
          control: check;
          title: _("15 minutes");
        }

        $ToggleRow preset_30m {
          control: check;
          title: _("30 minutes");
        }

        $ToggleRow preset_1h {
          control: check;
          title: _("1 hour");
        }

        $ToggleRow preset_2h {
          control: check;
          title: _("2 hours");
        }

        $ToggleRow preset_4h {
          control: check;
          title: _("4 hours");
        }
      }

      $Section others {
        visible: false;
        title: _("Kept awake by");

        $InhibitorList list {}
      }
    }

    [footer]
    $ActionRow footer {
      visible: false;
    }
  }
}
