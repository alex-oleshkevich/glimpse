{
  "name": "glimpse-sdk",
  "version": "0.9.0",
  "description": "React renderer for glimpse panel applets: write the indicator and popover in JSX, run it under Node.",
  "keywords": ["glimpse", "applet", "panel", "wayland", "react"],
  "license": "BSD-3-Clause",
  "author": "Alex Oleshkevich",
  "homepage": "https://github.com/alex-oleshkevich/glimpse/tree/master/sdk/applet#readme",
  "bugs": "https://github.com/alex-oleshkevich/glimpse/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-oleshkevich/glimpse.git",
    "directory": "sdk/applet"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "PROTOCOL.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.33.1",
    "react": "19.3.0",
    "react-reconciler": "0.34.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
