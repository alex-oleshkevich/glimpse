import { Indicator, Popover, Row, run, Section } from "glimpse-sdk";

const ICON = {{ icon | tojson }};
const NAME = {{ name | tojson }};

function App() {
    return (
        <>
            <Indicator icon={ICON} tooltip={NAME}>
                {NAME}
            </Indicator>
            <Popover icon={ICON} title={NAME}>
                <Section title={NAME}>
                    <Row title="It works" />
                </Section>
            </Popover>
        </>
    );
}

await run(<App />);
