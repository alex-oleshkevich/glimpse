{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "glimpse-sdk",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": ["index.tsx"]
}
