use glimpse_sdk::*;
use std::process::ExitCode;

struct App;

enum Msg {}

impl glimpse_sdk::App for App {
    type Msg = Msg;

    fn update(&mut self, _ctx: &Ctx, msg: Msg) {
        match msg {}
    }

    fn build(&self, _ctx: &Ctx) -> Vec<Widget<Msg>> {
        vec![
            indicator()
                .prop("icon", {{ icon | tojson }})
                .prop("tooltip", {{ name | tojson }})
                .text({{ name | tojson }}),
            popover()
                .prop("icon", {{ icon | tojson }})
                .prop("title", {{ name | tojson }})
                .child(
                    section()
                        .prop("title", {{ name | tojson }})
                        .child(row().prop("title", "It works")),
                ),
        ]
    }
}

fn main() -> ExitCode {
    run(App)
}
