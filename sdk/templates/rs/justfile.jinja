[doc("list recipes")]
default:
    @just --list --unsorted

[doc("build production files into dist/")]
build:
    cargo build --release
    cp "${CARGO_TARGET_DIR:-target}/release/{{ slug }}" ./{{ slug }}
    mkdir -p dist
    cp {{ slug }} {{ id }}.desktop dist/

[doc("run the applet in the panel, restarting on source edits")]
dev: build
    glimpsectl applet run --dev .

[doc("build the package and install it")]
install:
    glimpsectl applet package --install .

[doc("build the applet package")]
package:
    glimpsectl applet package .

[doc("run the tests")]
test:
    cargo test

[doc("lint")]
lint:
    cargo clippy --all-targets -- -D warnings
