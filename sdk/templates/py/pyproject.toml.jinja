[project]
name = {{ slug | tojson }}
version = "0.1.0"
requires-python = ">=3.14"
dependencies = ["glimpse-applet-sdk>=0.9"]

[dependency-groups]
dev = ["mypy", "pytest", "ruff"]

[tool.ruff]
line-length = 120
indent-width = 4
extend-exclude = ["dist"]

[tool.ruff.format]
indent-style = "space"
skip-magic-trailing-comma = false

[tool.mypy]
files = ["."]
exclude = "(^|/)dist/"
strict = true
python_version = "3.14"
