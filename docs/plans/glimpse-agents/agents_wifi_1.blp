using Gtk 4.0;
using Adw 1;

Adw.Clamp {
  maximum-size: 760;
  tightening-threshold: 760;
  valign: center;

  child: Gtk.Box {
  styles [
    "agent-dialog",
  ]

  Adw.StatusPage {
    hexpand: true;
    icon-name: "network-wireless-symbolic";
    title: _("Join “Café Central”");
    description: _("The network needs a password");

    styles [
      "compact",
    ]

    child: Gtk.Box {
    orientation: vertical;
    spacing: 18;

    Gtk.ListBox {
      selection-mode: none;

      styles [
        "boxed-list",
      ]


      Adw.PasswordEntryRow {
        title: _("Password");
      }

      Adw.SwitchRow {
        title: _("Connect automatically");
        active: true;
      }

    }

    Gtk.Box {
      spacing: 12;
      homogeneous: true;
      margin-top: 12;


      Gtk.Button {
        label: _("Cancel");

        styles [
          "pill",
        ]
      }

      Gtk.Button {
        label: _("Join");
        sensitive: false;

        styles [
          "pill",
          "suggested-action",
        ]
      }
    }
  };
  }
  };
}
