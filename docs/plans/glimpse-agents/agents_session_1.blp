using Gtk 4.0;
using Adw 1;

Adw.Clamp {
  maximum-size: 760;
  tightening-threshold: 760;
  valign: center;

  child: Gtk.Box {
  styles [
    "agent-dialog",
  ]

  Adw.StatusPage {
    hexpand: true;
    icon-name: "system-shutdown-symbolic";
    title: _("Power off?");
    description: _("Unsaved work in open apps may be lost");

    styles [
      "compact",
    ]

    child: Gtk.Box {
    orientation: vertical;
    spacing: 18;

    Gtk.Box {
      spacing: 12;
      homogeneous: true;
      margin-top: 12;


      Gtk.Button {
        label: _("Cancel");

        styles [
          "pill",
        ]
      }

      Gtk.Button {
        label: _("Power off");

        styles [
          "pill",
          "suggested-action",
        ]
      }
    }
  };
  }
  };
}
