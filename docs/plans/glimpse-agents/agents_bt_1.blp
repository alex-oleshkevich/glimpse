using Gtk 4.0;
using Adw 1;

Adw.Clamp {
  maximum-size: 760;
  tightening-threshold: 760;
  valign: center;

  child: Gtk.Box {
  styles [
    "agent-dialog",
  ]

  Adw.StatusPage {
    hexpand: true;
    icon-name: "bluetooth-active-symbolic";
    title: _("Pair with “Pixel 9”?");
    description: _("Check that the phone shows the same code");

    styles [
      "compact",
    ]

    child: Gtk.Box {
    orientation: vertical;
    spacing: 18;

    Gtk.Label {
      label: "482 913";
      halign: center;

      styles [
        "agent-code",
        "numeric",
      ]
    }

    Gtk.Box {
      spacing: 12;
      homogeneous: true;
      margin-top: 12;


      Gtk.Button {
        label: _("Cancel");

        styles [
          "pill",
        ]
      }

      Gtk.Button {
        label: _("Pair");

        styles [
          "pill",
          "suggested-action",
        ]
      }
    }
  };
  }
  };
}
