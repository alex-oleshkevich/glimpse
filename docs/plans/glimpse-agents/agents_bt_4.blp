using Gtk 4.0;
using Adw 1;

Adw.Clamp {
  maximum-size: 760;
  tightening-threshold: 760;
  valign: center;

  child: Gtk.Box {
  styles [
    "agent-dialog",
  ]

  Adw.StatusPage {
    hexpand: true;
    icon-name: "bluetooth-active-symbolic";
    title: _("“JBL Flip” wants to connect");
    description: _("It has never been paired with this computer");

    styles [
      "compact",
    ]

    child: Gtk.Box {
    orientation: vertical;
    spacing: 18;

    Gtk.Box {
      spacing: 12;
      homogeneous: true;
      margin-top: 12;


      Gtk.Button {
        label: _("Deny");

        styles [
          "pill",
        ]
      }

      Gtk.Button {
        label: _("Allow");

        styles [
          "pill",
          "suggested-action",
        ]
      }
    }
  };
  }
  };
}
