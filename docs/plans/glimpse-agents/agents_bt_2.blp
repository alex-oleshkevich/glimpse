using Gtk 4.0;
using Adw 1;

Adw.Clamp {
  maximum-size: 760;
  tightening-threshold: 760;
  valign: center;

  child: Gtk.Box {
  styles [
    "agent-dialog",
  ]

  Adw.StatusPage {
    hexpand: true;
    icon-name: "bluetooth-active-symbolic";
    title: _("Pair with “Old Headset”");
    description: _("Enter the PIN from the device's manual — often 0000");

    styles [
      "compact",
    ]

    child: Gtk.Box {
    orientation: vertical;
    spacing: 18;

    Gtk.ListBox {
      selection-mode: none;

      styles [
        "boxed-list",
      ]


      Adw.EntryRow {
        title: _("PIN");
        input-purpose: digits;
      }

    }

    Gtk.Box {
      spacing: 12;
      homogeneous: true;
      margin-top: 12;


      Gtk.Button {
        label: _("Cancel");

        styles [
          "pill",
        ]
      }

      Gtk.Button {
        label: _("Pair");

        styles [
          "pill",
          "suggested-action",
        ]
      }
    }
  };
  }
  };
}
