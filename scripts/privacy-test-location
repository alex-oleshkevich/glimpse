#!/usr/bin/env bash
#
# Hold a GeoClue client open for DURATION seconds (default 10) using the
# geoclue-2.0 demo binary `where-am-i`. Exercises
# org.freedesktop.GeoClue2.Manager.InUse, which the privacy applet's
# location indicator watches; while this runs, InUse should read true.
#
# Caveat (glimpse-ec4o.1, open): InUse is a single boolean shared by every
# GeoClue client, and the shared geolocation service both glimpse-weather
# and glimpse-sunset depend on never releases its client once it takes a
# fix — so InUse can already be stuck true before this
# script runs, and this test cannot show the false-to-true transition in
# that case. Check InUse via `gdbus call --system --dest
# org.freedesktop.GeoClue2 --object-path /org/freedesktop/GeoClue2/Manager
# --method org.freedesktop.DBus.Properties.Get
# org.freedesktop.GeoClue2.Manager InUse` before trusting what this script
# demonstrates.
#
# Usage: ./scripts/privacy-test-location [SECONDS]

set -euo pipefail

duration="${1:-10}"

bin=""
for candidate in \
    "$(command -v where-am-i 2>/dev/null || true)" \
    /usr/lib/geoclue-2.0/demos/where-am-i \
    /usr/libexec/geoclue-2.0/demos/where-am-i \
    /usr/lib64/geoclue-2.0/demos/where-am-i
do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
        bin="$candidate"
        break
    fi
done

if [[ -z "$bin" ]]; then
    echo "geoclue 'where-am-i' demo binary not found." >&2
    echo "Install geoclue-2.0 (Arch: geoclue) which ships the demo at" >&2
    echo "/usr/lib/geoclue-2.0/demos/where-am-i, or expose it on PATH." >&2
    exit 1
fi

echo "Holding GeoClue client open via $bin for ${duration}s"
"$bin" -t "$duration"
echo "done"
